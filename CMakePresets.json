{
	"version": 6,
	"cmakeMinimumRequired": {
		"major": 3,
		"minor": 26,
		"patch": 0
	},
	"include": [
		"cmake/presets/bases.json",
		"cmake/presets/build-types.json"
	],
	"configurePresets": [
    {
      "name": "linux-debug",
      "displayName": "Linux native, Debug",
      "inherits": [ "linux-base", "debug" ]
    },
    {
      "name": "linux-release",
      "displayName": "Linux native, Release",
      "inherits": [ "linux-base", "release" ]
    },

    {
      "name": "linux-to-windows-debug",
      "displayName": "Cross: Linux -> Windows, Debug",
      "inherits": [ "mingw-base", "debug" ]
    },
    {
      "name": "linux-to-windows-release",
      "displayName": "Cross: Linux -> Windows, Release",
      "inherits": [ "mingw-base", "release" ]
    },

    {
      "name": "windows-debug",
      "displayName": "Windows native, Debug",
      "inherits": [ "windows-base", "debug" ]
    },
    {
      "name": "windows-release",
      "displayName": "Windows native, Release",
      "inherits": [ "windows-base", "release" ]
    },

    {
      "name": "macos-debug",
      "displayName": "macOS native, Debug",
      "inherits": [ "macos-base", "debug" ]
    },
    {
      "name": "macos-release",
      "displayName": "macOS native, Release",
      "inherits": [ "macos-base", "release" ]
    },
    {
      "name": "macos-to-windows-debug",
      "displayName": "Cross: macOS -> Windows, Debug",
      "inherits": [ "mingw-base", "debug" ]
    },
    {
      "name": "macos-to-windows-release",
      "displayName": "Cross: macOS -> Windows, Release",
      "inherits": [ "mingw-base", "release" ]
    }
	],
	"buildPresets": [
    { "name": "linux-debug", "configurePreset": "linux-debug" },
    { "name": "linux-release", "configurePreset": "linux-release" },
    { "name": "windows-debug", "configurePreset": "windows-debug" },
    { "name": "windows-release", "configurePreset": "windows-release" },
    { "name": "macos-debug", "configurePreset": "macos-debug" },
    { "name": "macos-release", "configurePreset": "macos-release" },

    { "name": "linux-to-windows-debug", "configurePreset": "linux-to-windows-debug" },
    { "name": "linux-to-windows-release", "configurePreset": "linux-to-windows-release" },
    { "name": "macos-to-windows-debug", "configurePreset": "macos-to-windows-debug" },
    { "name": "macos-to-windows-release", "configurePreset": "macos-to-windows-release" }
	],
	"testPresets": [
		{
			"name": "debug",
			"configurePreset": "debug",
			"output": { "outputOnFailure": true }
		},
		{
			"name": "release",
			"configurePreset": "release",
			"output": { "outputOnFailure": true }
		}
	]
}
